{
  "description": "Auto-resolves Memlin context on every prompt; bidirectionally syncs ~/.claude/plans/ with the Memlin workspace.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hooks/session-start.js"]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hooks/user-prompt-submit.js"]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hooks/stop.js"]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hooks/pre-tool-use.js"]
          }
        ],
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|ApplyPatch|apply_patch|Task|mcp__.*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hooks/post-tool-use.js"]
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|ApplyPatch|apply_patch|Bash|ExitPlanMode"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/dist/hooks/post-tool-use-failure.js"]
          }
        ],
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|ApplyPatch|apply_patch|Bash"
      }
    ]
  }
}
